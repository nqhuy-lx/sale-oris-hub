<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_oris_hub" model="ir.ui.view">
        <field name="name">delivery.carrier.form.oris.hub</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="ghtk_pickup_partner_id"
                       invisible="delivery_type != 'ghtk'"
                       required="delivery_type == 'ghtk'"/>
                <field name="ghtk_fee_request_code"
                       invisible="delivery_type != 'ghtk'"
                       required="delivery_type == 'ghtk'"/>
                <field name="ghtk_create_request_code"
                       invisible="delivery_type != 'ghtk'"
                       required="delivery_type == 'ghtk'"/>
                <field name="ghtk_cancel_request_code"
                       invisible="delivery_type != 'ghtk'"
                       required="delivery_type == 'ghtk'"/>
                <field name="ghtk_tracking_url"
                       invisible="delivery_type != 'ghtk'"/>
            </xpath>
        </field>
    </record>
</odoo>
